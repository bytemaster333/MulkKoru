{
  "expo": {
    "name": "MulkKoru",
    "slug": "mulkkoru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mulkkoru",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3525cd"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mulkkoru.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3525cd"
      },
      "package": "com.mulkkoru.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MülkKoru mülk fotoğraflarınıza erişmek istiyor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
